    --> "React Web Application submits garment data"
    --> "FastAPI Backend validates request"
    --> "FastAPI Backend forwards garment data"
    --> "Garment Processing Module validates mandatory information"
    --> "Garment Processing Module validates measurements"
    --> "Garment Processing Module validates uploaded image"

    if "Garment data valid?" then
        -->[Yes] "Garment Processing Module returns valid garment data"
        --> "FastAPI Backend stores garment information"
        --> "PostgreSQL Database saves garment record"
