skinparam activity {
    BackgroundColor White
    BorderColor Black
    FontColor Black
    FontSize 10
}

(*) --> "User submits request"
--> "React performs client-side validation"

if "Frontend data valid?" then
    -->[Yes] "Request sent to FastAPI"
