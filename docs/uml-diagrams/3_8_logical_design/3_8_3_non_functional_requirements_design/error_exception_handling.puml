    if "Backend data valid?" then
        -->[Yes] "Identify request type"

        if "Video processing?" then
            -->[Yes] "Validate video format and readability"

            if "Video valid?" then
                -->[Yes] "OpenCV and MediaPipe process video"
                --> "Continue normal processing"
                --> (*)

            else
                -->[No] "Return video validation error"
                --> "React displays descriptive error"
                --> (*)
            endif

        else
            -->[No] "Validate garment information"
            --> "Validate dimensions, sizes and image"

            if "Garment data valid?" then
                -->[Yes] "Continue garment processing"
