# ============================================================
# SmartFit Environment Configuration
# ============================================================
#
# Copy this file to .env and replace the placeholder values
# with your local configuration.
#
# The .env file must NOT be committed to Git.
# ============================================================


# ============================================================
# Development Database
# ============================================================
#
# PostgreSQL database used by the SmartFit application.
#
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/SmartFit_db


# ============================================================
# Test Database
# ============================================================
#
# PostgreSQL database used exclusively by automated tests.
#
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/SmartFit_Test_db


# ============================================================
# JWT Authentication
# ============================================================
#
# Secret key used to sign JWT access tokens.
#
# Generate a secure value locally.
#
SECRET_KEY=YOUR_SECRET_KEY


# JWT signing algorithm.
#
ALGORITHM=HS256


# Number of minutes before a JWT access token expires.
#
ACCESS_TOKEN_EXPIRE_MINUTES=30